, 			{
				"box" : 				{
					"code" : "\r\n// DECLARATIONS\r\nSmoothingFilter__Next(filters, time, bank, chan, xn){\r\n\ta1 = exp(-twopi/(time*samplerate));\r\n\tb0 = 1.0-a1;\r\n\tyn = peek(filters,0,chan, channels=1);\r\n\tyn = (b0*xn) + (yn*a1);\r\n\tpoke(filters,yn,0,chan);\r\n\treturn yn;\r\n}\r\n\r\nDelayLine__Write(delay_memory, channel, count, input)\r\n{\n\twrite_pos = wrap(count, 0, dim(delay_memory));\n\tpoke(delay_memory, input, write_pos, channel,0);\r\n}\r\n\r\nDelayLine__Read(delay_memory, delay_time, channel, count)\r\n{\n\tread_pos = wrap(count - delay_time - 1, 0, dim(delay_memory));\n\toutput = peek(delay_memory, read_pos, channel, interp=\"linear\", channels=1);\r\n\r\n\treturn output;\r\n}\r\n\r\nDelayLine__Next(delay_memory, delay_time, channel, count, input)\r\n{\n\twrite_pos = wrap(count, 0, dim(delay_memory));\n\tpoke(delay_memory, input, write_pos, channel,0);\r\n\tread_pos = wrap(count - delay_time-1, 0, dim(delay_memory));\n\toutput = peek(delay_memory, read_pos, channel, interp=\"linear\", channels=1);\r\n\r\n\treturn output;\r\n}\r\n\r\nHalmardMixer4(x1,x2,x3,x4){\r\n\tmultiplier = -2.0/4.0;\r\n\tsum = x1 + x2 + x3 + x4;\r\n\tsum *= multiplier;\r\n\treturn x1+sum, x2+sum, x3+sum, x4+sum;\r\n}\r\n\r\nHalmardMixer8(x1,x2,x3,x4,x5,x6,x7,x8){\r\n\tmultiplier = -2.0/8.0;\r\n\tsum = x1 + x2 + x3 + x4 + x5 + x6 +x7 +x8 ;\r\n\tsum *= multiplier;\r\n\treturn x1+sum, x2+sum, x3+sum, x4+sum, x5+sum, x6+sum, x7+sum, x8+sum;\r\n}\r\n\r\nHalmardMixerN(values){\r\n\tN = channels(values);\r\n\tmultiplier = -2.0/N;\r\n\tsum = 0;\r\n\tfor(i=0;i<N;i+=1){\r\n\t\tsum+= peek(values,0,i,channels=1);\r\n\t\t}\r\n\tsum *= multiplier;\r\n\t\r\n\tfor(i=0;i<N;i+=1){\r\n\t\tx = peek(values,0,i,channels=1);\r\n\t\tpoke(values, x+sum, 0, i, 0);\r\n\t}\r\n\r\n}\r\n\r\nDiffusor4__Next(diffusor_memory, delay_lines_times, polarity, smoothingFilters, modulators, bank, count, input1, input2, input3, input4){\r\n\r\n\r\nt1,t2,t3,t4 = peek(delay_lines_times,bank,0,channels=4);\r\nm1,m2,m3,m4 = peek(modulators,bank,0,channels=4);\r\nmax_time = dim(diffusor_memory)-1;\r\n\r\n\r\nm1 = SmoothingFilter__Next(smoothingFilters, 2, bank, 0,  m1);\r\nm2 = SmoothingFilter__Next(smoothingFilters, 2, bank, 1,  m2);\r\nm3 = SmoothingFilter__Next(smoothingFilters, 2, bank, 2,  m3);\r\nm4 = SmoothingFilter__Next(smoothingFilters, 2, bank, 3,  m4);\r\n\r\nt1 = clamp(t1+m1,1,max_time);\r\nt2 = clamp(t2+m2,1,max_time);\r\nt3 = clamp(t3+m3,1,max_time);\r\nt4 = clamp(t4+m4,1,max_time);\r\n\r\nwrite_pos = count;\r\n\npoke(diffusor_memory, input1, write_pos, 0 + bank*4, 0, boundmode=\"wrap\");\r\npoke(diffusor_memory, input2, write_pos, 1 + bank*4, 0, boundmode=\"wrap\");\r\npoke(diffusor_memory, input3, write_pos, 2 + bank*4, 0, boundmode=\"wrap\");\r\npoke(diffusor_memory, input4, write_pos, 3 + bank*4, 0, boundmode=\"wrap\");\r\n\r\n\r\ns1 = peek(diffusor_memory, count - t1, 0 + bank*4, boundmode=\"wrap\", interp=\"linear\", channels=1); //DelayLine__Next(diffusor_memory, t1,0,count,input1);\r\ns2 = peek(diffusor_memory, count - t2, 1 + bank*4, boundmode=\"wrap\", interp=\"linear\", channels=1);// DelayLine__Next(diffusor_memory, t2,1,count,input2);\r\ns3 = peek(diffusor_memory, count - t3, 2 + bank*4, boundmode=\"wrap\", interp=\"linear\", channels=1);//DelayLine__Next(diffusor_memory, t3,2,count,input3);\r\ns4 = peek(diffusor_memory, count - t4, 3 + bank*4, boundmode=\"wrap\", interp=\"linear\", channels=1);//DelayLine__Next(diffusor_memory, t4,3,count,input4);\r\n\r\n\r\np1 = -1;//peek(polarity,0,0);\r\np2 = 1;//peek(polarity,0,1);\r\np3 = -1;//peek(polarity,0,2);\r\np4 = 1;//peek(polarity,0,3);\r\n\r\n\r\ns1 *= p1;\r\ns2 *= p2;\r\ns3 *= p3;\r\ns4 *= p4;\r\n\r\n\r\ns1,s2,s3,s4 = HalmardMixer4(s1,s2,s3,s4);\r\n\r\n/*\r\ns1 *= p1;\r\ns2 *= p2;\r\ns3 *= p3;\r\ns4 *= p4;\r\n*/\r\n\r\nreturn s1,s2,s3,s4;\r\n}\r\n\r\nSRR(srrclock, x){\r\n\treturn sah(x, srrclock>0);\r\n}\r\n\r\nLowpassFIR__Next(filter, bank, x){\r\n\t\r\n\tx1,x2,x3,x4 = peek(filter,0,0, channels=4);\r\n\t\r\n\tyn = x + 0.8*x1 + 0.7*x2 + 0.6*x3 + 0.5*x4;\r\n\t\r\n\tpoke(filter,x, bank,0,0);\r\n\tpoke(filter,x1,bank,0,0);\r\n\tpoke(filter,x2,bank,0,0);\r\n\tpoke(filter,x3,bank,0,0);\r\n\tpoke(filter,x4,bank,0,0);\r\n\t\r\n\treturn yn;\r\n\t\r\n}\r\n\r\n//Diffusors\r\nData diffusor_memory_1(samplerate*4,16);\r\nData diffusor_smoothing_1(4,4);\r\nData diffusor_times_1(4,4);\r\nData diffusor_polarity_1(4,4);\r\nData diffusor_mod_1(4,4);\r\nData diffusor_values(4,1);\r\n\r\n\r\n// Tank\r\nData tank_memory_1(samplerate*5,8);\r\nData tank_times_1(samplerate,8);\r\nData tank_smoothing_1(1,8);\r\nData tank_feedback(1,8);\r\nData tank_lp(8,4);\r\nData tank_mod(1,8);\r\nData tank_values(1,8);\r\nBuffer tank_shape(\"tank_shape\");\r\n\r\nBuffer diffusor_shape(\"diffusor_shape\");\r\nBuffer diffusor_polarity(\"diffusor_polarity\");\r\nBuffer window;\r\n\r\n\r\n//Params\r\nParam srr_dry_wet(0,min=0,max=1);\r\nParam srr_crush(1,min=1,max=128);\r\nParam decay_seconds(8,min=1,max=60);\r\nParam diffusor_mod_depth(0.1,min=0,max=1);\r\nParam tank_mod_depth(0.01,min=0,max=1);\r\nParam diffusor_mod_speed(0.9,min=0,max=10000);\r\nParam tank_mod_speed(0.01,min=0,max=10000);\r\nParam late_reflections_size(0.5,min=0.1,max=4);\r\nParam early_reflections_size(0.5,min=0.1,max=4);\r\nParam early_reflections(-6);\r\nParam late_reflections(-10);\r\nHistory erEnvPhase(0);\r\nHistory lrEnvPhase(0);\r\nDelay lrSizeDelayed(samplerate*0.1);\r\nDelay erSizeDelayed(samplerate*0.1);\r\ndropoutduration = samplerate*0.04;\r\n\r\n\r\nerEnv = 1 - peek(window, 2048*(erEnvPhase/dropoutduration), boundmode=\"clip\", channels=1);\r\nlrEnv = 1 - peek(window, 2048*(lrEnvPhase/dropoutduration), boundmode=\"clip\", channels=1);\r\n\r\nerEnvPhase += 1;\r\nlrEnvPhase += 1;\r\n\r\n// FX\r\ncount = counter(1,0,0);\r\ntimer = counter(1,0,samplerate*2);\r\nsrr_clock = counter(1,0,srr_crush);\r\n\r\ndiffusor_max_len = dim(diffusor_memory_1);\r\ndiffusor_min_len = 1;\r\ndiffusor_delay_range = diffusor_max_len - diffusor_min_len;\r\n\r\ntank_max_len = samplerate*room_size;\r\ntank_min_len = samplerate*0.015;\r\ntank_delay_range = tank_max_len - tank_min_len;\r\n\r\n// randomize diffusor shape\r\n/*\r\nif(in3>0 ){\r\n\r\n\tfor(i=0;i<4;i+=1){\r\n\t\tfor(j=0;j<4;j+=1){\r\n\t\r\n\t\tpoke(diffusor_polarity_1, noise()>0.5?1:-1,j,i);\t\t\t\r\n\t\tpoke(diffusor_times_1, 0.1*diffusor_delay_range*abs(noise()) + diffusor_min_len,j,i);\t\t\t\r\n\t\r\n\t\t}\r\n\t}\r\n}\r\n*/\r\n\r\n\r\nif(elapsed==0 || abs(delta(late_reflections_size))>0 || in3>0){\r\n\tlrEnvPhase = 0;\r\n}\r\n\r\nlrSizeDelayed.write(late_reflections_size);\r\nlrsize = lrSizeDelayed.read(dropoutduration*0.5);\r\n\tfor(i=0;i<8;i+=1){\r\n\t\t//poke(tank_times_1, tank_delay_range*abs(2*noise()*noise()) + tank_min_len,0,i);\r\n\t\tt = peek(tank_shape, i, 0);\r\n\t\t\r\n\t\tpoke(tank_times_1, t*samplerate*lrsize ,0,i);\r\n\t}\r\n\r\n\r\nerSizeDelayed.write(early_reflections_size);\r\nersize = erSizeDelayed.read(dropoutduration*0.5);\r\n\r\nif(elapsed==0 || abs(delta(early_reflections_size))>0 || in3>0){\r\n\r\n\terEnvPhase = 0;\r\n}\r\n\tfor(i=0;i<4;i+=1){\r\n\t\tfor(j=0;j<4;j+=1){\r\n\t\t//poke(tank_times_1, tank_delay_range*abs(2*noise()*noise()) + tank_min_len,0,i);\r\n\t\tshape_param = peek(diffusor_shape, i + j*4,0);\r\n\t\t\r\n\t\tpoke(diffusor_times_1, shape_param*samplerate*ersize,j,i);\r\n\t\t}\r\n\t}\r\n\r\n\r\n\r\n\r\n\r\nL = in1*erEnv;\r\nR = in2*erEnv;\r\n\r\nd1,d2,d3,d4 = Diffusor4__Next(diffusor_memory_1, diffusor_times_1, diffusor_polarity_1, diffusor_smoothing_1, diffusor_mod_1, 0, count, L, R, L, R);\r\nd1 *= erEnv;\r\nd2 *= erEnv;\r\nd3 *= erEnv;\r\nd4 *= erEnv;\r\nd1,d2,d3,d4 = Diffusor4__Next(diffusor_memory_1, diffusor_times_1, diffusor_polarity_1, diffusor_smoothing_1, diffusor_mod_1, 1, count, d1,d2,d3,d4);\r\nd1 *= erEnv;\r\nd2 *= erEnv;\r\nd3 *= erEnv;\r\nd4 *= erEnv;\r\nd1,d2,d3,d4 = Diffusor4__Next(diffusor_memory_1, diffusor_times_1, diffusor_polarity_1, diffusor_smoothing_1, diffusor_mod_1, 2, count, d1,d2,d3,d4);\r\nd1 *= erEnv;\r\nd2 *= erEnv;\r\nd3 *= erEnv;\r\nd4 *= erEnv;\r\nd1,d2,d3,d4 = Diffusor4__Next(diffusor_memory_1, diffusor_times_1, diffusor_polarity_1, diffusor_smoothing_1, diffusor_mod_1, 3, count, d1,d2,d3,d4);\r\nd1 *= erEnv;\r\nd2 *= erEnv;\r\nd3 *= erEnv;\r\nd4 *= erEnv;\r\n\r\npoke(diffusor_values, d1,0,0);\r\npoke(diffusor_values, d2,1,0);\r\npoke(diffusor_values, d3,2,0);\r\npoke(diffusor_values, d4,3,0);\r\n\r\ntfb_level = clamp(t60(decay_seconds),0,1);\r\na1 = exp(-twopi/(4*samplerate));\r\nb0 = 1.0-a1;\r\nfor(i=0; i<8;i+=1){\r\n\ttfb = peek(tank_feedback, 0, i, channels=1);\r\n\ttfb *= tfb_level;\r\n\tti = peek(diffusor_values, i, 0, boundmode=\"wrap\", channels=1) + tfb;\r\n\tpoke(tank_memory_1, ti, count, i,0, boundmode=\"wrap\");\r\n\ttd = peek(tank_times_1,0,i,channels=1);\r\n\ttm = peek(tank_mod,0,i,channels=1);\r\n\ttd = td+SmoothingFilter__Next(tank_smoothing_1, 2, i, tm);\r\n//\txn = clamp(td + tm,1,dim(tank_memory_1)-1);\r\n//\tyn = peek(tank_smoothing_1,0,i, channels=1);\r\n//\tyn = (b0*xn) + (yn*a1);\r\n//\tpoke(tank_smoothing_1,yn,0,i);\r\n//\ttd = yn;\r\n\ttd = clamp(td,1,dim(tank_memory_1)-1);\r\n\tt_o = peek(tank_memory_1, count-td, i, 0, boundmode=\"wrap\", channels=1, interp=\"spline\");\r\n//\tpoke(tank_feedback, t_o, 0, i);\r\n\tpoke(tank_values, t_o, 0, i);\r\n}\r\n//HalmardMixerN(tank_values);\r\n\r\nN = channels(tank_values);\r\nmultiplier = -2.0/N;\r\nsum = 0;\r\nfor(i=0;i<N;i+=1){\r\n\tsum+= peek(tank_values,0,i,channels=1);\r\n}\r\nsum *= multiplier;\r\n\t\r\nfor(i=0;i<N;i+=1){\r\n\tx = peek(tank_values,0,i,channels=1);\r\n\tpoke(tank_values, x+sum, 0, i, 0);\r\n}\r\nto1, to2, to3, to4, to5, to6, to7, to8 = peek(tank_values, 0,0, channels=8);\r\n\r\n\r\nfor(i=0; i<8;i+=1){\r\n\tt_o = peek(tank_values, 0, i, channels=1);\r\n\t/*\r\n\treduced = sah(t_o, srr_clock>0);\r\n\treduced = LowpassFIR__Next(tank_lp,i,reduced);\r\n\tt_o = mix(t_o, reduced, srr_dry_wet);\r\n\t*/\r\n\tpoke(tank_feedback, t_o, 0, i, 0);\r\n\t\r\n}\r\n\r\n\r\nmod_phase = phasor(diffusor_mod_speed,0);\r\nmod_trig = delta(mod_phase)<0;\r\n\r\n\r\ntmod_phase = phasor(tank_mod_speed,0);\r\ntmod_trig = delta(mod_phase)<0;\r\n\r\n\r\n\r\nfor(i =0; i<4; i+=1){\r\n\tfor(j =0; j<4; j+=1){\r\n\tmod1 = latch(samplerate*noise(), mod_trig);\r\n\tlast1 = latch(peek(diffusor_mod_1, 0, i, channels=1),mod_trig);\r\n\tmod1 = mix(last1, mod1, mod_phase);\r\n\tpoke(diffusor_mod_1, 0.01*diffusor_mod_depth*mod1,j,i);\t\r\n\t\r\n\r\n\t}\r\n}\r\n\r\nfor(i =0; i<8; i+=1){\r\n\tmod1 = latch(0.1*samplerate*noise(), tmod_trig);\r\n\tlast1 = latch(peek(tank_mod, 0, i, channels=1), tmod_trig);\r\n\tmod1 = mix(last1, mod1, tmod_phase);\r\n\tpoke(tank_mod,tank_mod_depth* mod1,0,i);\t\t\t\r\n\r\n}\r\n\r\nlra = dbtoa(late_reflections);\r\nera = dbtoa(early_reflections)*erEnv;\r\n\r\nout1 =  (to7*lra + era*d3)*0.5;\r\nout2 =  (to8*lra + era*d4)*0.5;\r\n\r\n\r\nout3, out4, out5, out6 =peek(diffusor_times_1,0,0,channels=4);\r\nout7, out8, out9, out10 = peek(diffusor_times_1,1,0,channels=4);\r\nout11, out12, out13, out14 = peek(diffusor_times_1,2,0,channels=4);\r\nout15, out16, out17, out18 =  peek(diffusor_times_1,3,0,channels=4);\r\n\r\nout19 = count;\r\n\r\n\r\n",
					"fontface" : 0,
