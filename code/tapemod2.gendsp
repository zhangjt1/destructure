, 			{
				"box" : 				{
					"code" : "Param dropouts(0.1);\r\n\r\nHistory dropout_counter(0.0);\r\nHistory dropout_active(0);\r\nHistory dropout_trigger(0);\r\nHistory dropout_depth(0);\r\nHistory lfo1_phase(0);\r\nData wobbleMemory(SAMPLERATE*2,2);\r\ncount = counter(1,0,0);\r\n\r\n\r\ndropout_duration = SAMPLERATE*0.21;\r\ndropout_attack_samps = (0.0041*SAMPLERATE);\r\ndropout_release_samps = (0.00229*SAMPLERATE);\r\nepsilon = 1e-9;\r\n\r\nL = in1; R = in2;\r\nmodnz = abs(in3);\r\nmodnz2 = abs(in4)*0.1;\r\nmodnz3 = abs(in5)*0.1;\r\n\r\nnz1 = in6;\r\nnz2 = in7;\r\nnz3 = in8;\r\ndepth = in9;\r\n\r\n\r\npoke(wobbleMemory, L, count, 0, 0, boundmode=\"wrap\");\r\npoke(wobbleMemory, R, count, 1, 0, boundmode=\"wrap\");\r\nL = peek(wobbleMemory, count - (modnz+modnz2)*SAMPLERATE*depth*0.01, 0, boundmode=\"wrap\", interp=\"linear\", channels=1);\r\nR = peek(wobbleMemory, count - (modnz+modnz3)*SAMPLERATE*depth*0.01, 0, boundmode=\"wrap\", interp=\"linear\", channels=1);\r\n\r\nlfo1_phase = wrap(lfo1_phase + 0.002, 0, 1);\nlfo1 = sin(lfo1_phase * twopi) * 0.5 + 0.5;\r\ndropout_counter = dropout_counter + 1;\ndropout_threshold = 20000 - (pow(0.7, 3) * 19900);\ndropout_base_chance = (dropout_threshold > epsilon ? (1 / dropout_threshold) : 1) * (pow(dropouts, 2) * 50 + 0.1); \ndropout_random_mod = 0.8 + abs(nz2) * 0.4;\ndropout_chance = dropout_base_chance * dropout_random_mod;\ndropout_trigger = abs(nz1) > (1 - dropout_chance);\n\nif (dropout_active < 0.5 && dropout_trigger) {\n    dropout_active = 1;\n    dropout_counter = 0;\n    dropout_duration_variation = 0.5 + abs(nz2) * 1.5;\n    dropout_duration = dropout_attack_samps + dropout_release_samps + floor(abs(nz2) * 2000 * 0.7  * dropout_duration_variation);\n    dropout_depth_variation = 0.5 + abs(nz3) * 0.5;\n    dropout_depth = 0.2 + abs(nz1) * 0.8 * pow(0.7, 1.5) * dropout_depth_variation;\n}\nif (dropout_active > 0.5 && dropout_counter > dropout_duration) {\n    dropout_active = 0;\n}\ndropout_depth_scaled = dropout_depth * (0.5 + pow(dropouts, 2) * 0.5) * (0.5 + pow(0.7, 2) * 0.5);\n\n\nattack_env = min(1, pow(dropout_counter / dropout_attack_samps,abs(nz2))); \nrelease_env = 1 - dropout_depth_scaled * (1 - min(1, pow(dropout_counter / dropout_release_samps, 0.5))); \ndropout_envelope = dropout_active > 0.5 ? release_env : attack_env;\ndropout_factor = dropout_envelope * (0.8 + lfo1 * 0.2);\n\nL = L * dropout_factor; \nR = R * dropout_factor;\r\n\r\n\r\n\r\n\r\n\r\nout1 = L;\r\nout2 = R;\r\n\r\n\r\n\r\n\r\n\r\n",
					"fontface" : 0,
					"fontname" : "<Monospaced>",
					"fontsize" : 10.0,
