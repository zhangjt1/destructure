, 			{
				"box" : 				{
					"code" : "Param srr_dry_wet(0,min=0,max=1);\r\nParam srr_crush(1,min=1,max=128);\r\nParam bit_depth(8);\r\nParam threshold(-40);\r\nParam ratio(1.5);\r\nParam time(0.02);\r\nHistory lastGain(0);\r\nHistory yn(0);\r\nHistory yn2(0);\r\nsrr_clock = counter(1,0,srr_crush);\r\nL = in1;\r\nR = in2;\r\nLgain = atodb(abs(L));\r\nRgain = atodb(abs(R));\r\n\r\ncomp_threshold = dbtoa(threshold);\r\ncomp_ratio = ratio;\r\nepsilon = 1e-9;\r\nlastGain = (L+R)/2;\r\npwr = abs(lastGain);\r\ncompression = 1;\r\n\r\n\r\n\ta1 = exp(-twopi/(time*samplerate));\r\n\tb0 = 1.0-a1;\r\n\txn = pwr;\r\n\tyn = (b0*xn) + (yn*a1);\r\npwr = yn;\r\n\r\nif (pwr > comp_threshold) {\n    // Added epsilon for division\n    compression = (comp_threshold + (pwr - comp_threshold) / (comp_ratio + epsilon));\n} \r\n\r\n\txn = compression;\r\n\tyn2 = (b0*xn) + (yn2*a1);\r\n\tcompression = yn2;\r\n/*\r\nif (pwr < comp_threshold) {\n    // Added epsilon for division\n    compression = (comp_threshold + (comp_threshold-pwr) / (comp_ratio + epsilon));\n} \r\n*/\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nbits = pow(2,bit_depth);\r\ncrushedL = L;\r\ncrushedL *= bits;\r\ncrushedL = int(crushedL);\r\ncrushedL /= bits;\r\ncrushedR = R;\r\ncrushedR *= bits;\r\ncrushedR = int(crushedR);\r\ncrushedR /= bits;\r\n\r\n\r\ndynmix = 1-compression;\r\ndynmix2 = 0;\r\n\r\n\r\nL = mix(L, crushedL, srr_dry_wet);\r\nR = mix(R, crushedR, srr_dry_wet);\r\n\r\nreducedL = sah(L, srr_clock>0);\r\nreducedR = sah(R, srr_clock>0);\r\nL = mix(L, reducedL, srr_dry_wet*(dynmix));\r\nR = mix(R, reducedR, srr_dry_wet*(dynmix));\r\n\r\nL = mix(L, L*(compression), srr_dry_wet);\r\nR = mix(R, R*(compression), srr_dry_wet);\r\nlPost = atodb(abs(L));\r\nrPost = atodb(abs(R));\r\nL *=dbtoa( Lgain-lPost);\r\nR *=dbtoa( Rgain-rPost);\r\n\r\nout1=L;\r\nout2=R;",
					"fontface" : 0,
					"fontname" : "<Monospaced>",
					"fontsize" : 10.0,
					"id" : "obj-3",
