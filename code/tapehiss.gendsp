, 			{
				"box" : 				{
					"code" : "// DECLARATIONS\r\nSmoothingFilter__Next(filters, time, bank, chan, xn){\r\n\ta1 = exp(-twopi/(time*samplerate));\r\n\tb0 = 1.0-a1;\r\n\tyn = peek(filters,0,chan, channels=1);\r\n\tyn = (b0*xn) + (yn*a1);\r\n\tpoke(filters,yn,0,chan);\r\n\treturn yn;\r\n}\r\n\r\n\r\nData followers(1,2);\r\nParam follow_time(0.001);\r\n\r\nHistory lfoPhase1(0.0202);\r\nHistory lfoPhase2(0.0202);\r\nHistory hp1_yn(0.0);\r\nHistory crackle_counter(0);\nHistory crackle_active(0);\nHistory crackle_amplitude(0);\r\n\r\nx1 = abs(in1);\r\nl1 = SmoothingFilter__Next(followers,follow_time, 0, 0, x1);\r\nl1 = abs(l1);\r\n\r\nx2 = abs(in2);\r\nl2 = SmoothingFilter__Next(followers,follow_time, 0, 1, x2);\r\nl2 = abs(l2);\r\n\r\nl1 = clamp(atodb(l1*1000),0, 7);\r\nl2 = clamp(atodb(l2*1000),0, 7);\r\n\r\nc1 = clamp(dbtoa(-l1),0,1);\r\nc2 = clamp(dbtoa(-l2),0,1);\r\n\r\nhsa = in3;\r\n\r\nnz1 = noise();\r\nnz2 = noise();\r\nnz3 = noise();\r\n\r\nnzmix = (nz1+nz2+nz3)*0.333333*mix(0.9,1.1,sin((lfoPhase1+lfoPhase2)*twopi));\r\n\r\n\r\nlfoPhase1 += 0.3*nz1*nz1/SAMPLERATE;\r\nlfoPhase2 += 0.1*nz3*nz3/SAMPLERATE;\r\nif(lfoPhase1>1){lfoPhase-=1;}\r\nif(lfoPhase2>1){lfoPhase-=1;}\r\nhp_cutoff = 300 / samplerate;\nhp1_yn   = hp1_yn + hp_cutoff * (nzmix - hp1_yn);\nfiltered_hiss = nzmix - hp1_yn;\r\nnzmix = filtered_hiss;\r\n\r\n// Random crackle generation (using tape_factor instead of tape_age)\r\n\r\ntape_factor = 0.8;\r\nepsilon = 1e-9;\r\ncrackle = in4;\ncrackle_counter += 1;\ncrackle_threshold = 10000 - (pow(tape_factor,2) * 9900);\n// Prevent division by zero if threshold is 0 or less\ncrackle_chance = crackle_threshold > epsilon ? (1 / crackle_threshold) : 1;\n\nif (nz1 > (1 - crackle_chance * 0.1) && crackle_active < 0.5 && crackle > 0) {\n    crackle_active = 1;\n    crackle_counter = 0;\n    crackle_amplitude = 0.2 + nz2  * tape_factor ;\n}\nif (crackle_counter > 20) {\n    crackle_active = 0;\n}\ncrackle_noise = crackle_active * crackle_amplitude *crackle* nz3;\r\n\r\nout1 = nzmix*hsa*c1 + crackle_noise;\r\nout2 = nzmix*hsa*c2 + crackle_noise*0.97;\r\nout3 = c1;\r\nout4 = c2;",
					"fontface" : 0,
					"fontname" : "<Monospaced>",
					"fontsize" : 10.0,
					"id" : "obj-3",
					"maxclass" : "codebox",
